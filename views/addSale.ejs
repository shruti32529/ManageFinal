<form action="/sales/add" method="POST">
    <label>Product Name:</label>
    <input type="text" name="productName" required><br><br>

    <label>Quantity:</label>
    <input type="number" name="quantity" required oninput="calculateTotal()"><br><br>

    <label>Sales Price:</label>
    <input type="number" name="salesPrice" required oninput="calculateTotal()"><br><br>

    <label>Total:</label>
    <input type="number" name="total" id="total" readonly><br><br>

    <label>Status:</label>
    <select name="status">
        <option value="Paid">Paid</option>
        <option value="Pending">Pending</option>
    </select><br><br>

    <button type="submit">Add Sale</button>
</form>

<script>
function calculateTotal() {
    let q = document.querySelector('[name="quantity"]').value;
    let p = document.querySelector('[name="salesPrice"]').value;
    document.getElementById("total").value = q * p;
}
</script>
