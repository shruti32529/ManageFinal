<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Product - ManageEasy</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>

<div class="main-container">

  <!-- Main Content -->
  <main class="dashboard-content">

    <header class="dashboard-header" style="display:flex;align-items:center;justify-content:space-between;">
      <h1 class="page-title">Add New Product</h1>
      <a href="/products" class="btn-action secondary"><i class="fas fa-arrow-left"></i> Back to Products</a>
    </header>

    <!-- Flash Messages -->
    <% if (messages && messages.success) { %>
      <div class="alert success"><%= messages.success %></div>
    <% } %>

    <% if (messages && messages.error) { %>
      <div class="alert error"><%= messages.error %></div>
    <% } %>

    <!-- Form Card -->
    <div class="card">
      <div class="card-header">Product Details</div>
      <div class="card-body">

        <form action="/products/add" method="POST">

          <div class="form-group">
            <label>Product Name</label>
            <input type="text" name="name" class="form-control" placeholder="Enter Product Name" required>
          </div>

          <div class="form-group">
            <label>Category</label>
            <select name="category" class="form-control" required>
              <option value="">Select Category</option>
              <% categories.forEach(c => { %>
                <option value="<%= c._id %>"><%= c.name %></option>
              <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label>Price (₹)</label>
            <input type="number" name="price" class="form-control" min="1" placeholder="Enter Price" required>
          </div>

          <div class="form-group">
            <label>Stock Quantity</label>
            <input type="number" name="stock" class="form-control" min="0" placeholder="Enter Stock Value" required>
          </div>

          <button type="submit" class="btn-submit">
            <i class="fas fa-check-circle"></i> Add Product
          </button>

        </form>

      </div>
    </div>

  </main>
</div>

<!-- CSS -->
<style>
  body { margin:0;font-family:'Open Sans',sans-serif;background:#f8f9fa;display:flex;min-height:100vh; }
  .main-container{ display:flex;width:100%; justify-content:center; padding:20px; }
  .dashboard-content{ flex-grow:1; max-width:600px; width:100%; }
  .page-title{ margin:0;font-weight:700;color:#212529; }

  .card{ background:#fff;border:1px solid #e9ecef;border-radius:8px;box-shadow:0 4px 6px rgba(0,0,0,0.05);margin-top:20px; }
  .card-header{ padding:15px;font-weight:600;background:#f8f9fa;border-bottom:1px solid #e9ecef; }
  .card-body{ padding:20px; }

  .form-group{ margin-bottom:16px; }
  label{ font-weight:600;margin-bottom:6px;display:block; }
  .form-control{ width:100%;padding:10px;border:1px solid #ced4da;border-radius:6px;font-size:1em; }

  .btn-action{ background:#007bff;color:#fff;padding:8px 14px;border-radius:6px;text-decoration:none;font-weight:600; }
  .btn-action.secondary{ background:#6c757d; }
  .btn-submit{ width:100%;padding:12px;background:#28a745;border:none;border-radius:6px;color:#fff;font-size:1.1em;font-weight:600;cursor:pointer; }
  .btn-submit:hover{ opacity:0.95; }

  .alert{ padding:10px 14px;border-radius:6px;margin-top:10px;font-weight:600; }
  .alert.success{ background:#d4edda;color:#155724; }
  .alert.error{ background:#f8d7da;color:#721c24; }
</style>

</body>
</html>
