<!-- scripts -->
<script src="/socket.io/socket.io.js"></script>
<script>
function toggleSubmenu(e) {
    e.preventDefault();
    const parent = e.currentTarget.parentElement;
    parent.classList.toggle('open');
    const submenu = parent.querySelector('.submenu');
    if (parent.classList.contains('open')) {
        submenu.style.maxHeight = submenu.scrollHeight + "px";
    } else {
        submenu.style.maxHeight = 0;
    }
}

// Profile dropdown toggle (unchanged)
(function () {
    const btn = document.getElementById('avatarBtn');
    const menu = document.getElementById('profileMenu');
    const wrap = document.getElementById('profileWrap');
    if (!btn || !menu) return;
    btn.addEventListener('click', function (e) {
        e.stopPropagation();
        const open = menu.getAttribute('aria-hidden') === 'false';
        menu.setAttribute('aria-hidden', String(!open));
        btn.setAttribute('aria-expanded', String(!open));
        menu.classList.toggle('open', !open);
    });
    document.addEventListener('click', function (e) {
        if (!wrap.contains(e.target)) {
            menu.setAttribute('aria-hidden', 'true');
            menu.classList.remove('open');
            btn.setAttribute('aria-expanded', 'false');
        }
    });
})();

/* ------------------ Notifications (socket.io client) ------------------ */

const socket = io(); // will connect to same origin

const notifCountEl = document.getElementById('notifCount');
const notifListEl = document.getElementById('notifList');
const notifDropdown = document.getElementById('notifDropdown');
const notifIcon = document.getElementById('notifIcon');

let unreadCount = 0;

// Utility: push notification to dropdown + update count
function pushNotification(message, meta = {}) {
    const li = document.createElement('li');

    // message and optional small meta (time/type)
    li.innerHTML = `<div>${escapeHtml(message)}</div>
                    ${meta.detail ? `<small>${escapeHtml(meta.detail)}</small>` : ''}`;
    // newest on top
    if (notifListEl.firstChild) notifListEl.insertBefore(li, notifListEl.firstChild);
    else notifListEl.appendChild(li);

    // update badge
    unreadCount += 1;
    notifCountEl.textContent = unreadCount;
    notifCountEl.style.display = 'inline-block';

    // show toast briefly
    showToast(message);
}

// Escape simple html to avoid injection
function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>"']/g, function(m) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]); });
}

// Toggle dropdown open/close
function toggleNotifications() {
    const open = notifDropdown.classList.toggle('open');
    notifDropdown.setAttribute('aria-hidden', String(!open));

    if (open) {
        // mark read (reset count)
        unreadCount = 0;
        notifCountEl.style.display = 'none';
        notifCountEl.textContent = '0';
    }
}

// click outside to close
document.addEventListener('click', function(e) {
    const area = document.querySelector('.notification-area');
    if (!area.contains(e.target)) {
        notifDropdown.classList.remove('open');
        notifDropdown.setAttribute('aria-hidden', 'true');
    }
});

// show toast
function showToast(text) {
    const t = document.createElement('div');
    t.className = 'toast';
    t.innerText = text;
    document.body.appendChild(t);
    // force reflow then show
    setTimeout(() => t.classList.add('show'), 10);
    setTimeout(() => {
        t.classList.remove('show');
        setTimeout(() => t.remove(), 300);
    }, 3500);
}

/* Listen to the specific events you emit from server-side */
socket.on('connect', () => {
    console.log('Socket connected:', socket.id);
});

// Generic notification (if you emit like io.emit('notification', { message }))
socket.on('notification', (data) => {
    const msg = (data && data.message) ? data.message : 'Notification';
    pushNotification(msg, { detail: data?.when || '' });
});

// Specific events (as used in your routes)
socket.on('newUser', (data) => {
    const msg = `New user added: ${data.name || data.email || 'Unknown'}`;
    pushNotification(msg, { detail: 'User created' });
});

socket.on('newGroup', (data) => {
    const msg = `New group created: ${data.name || 'Unnamed group'}`;
    pushNotification(msg, { detail: 'Group created' });
});

socket.on('newCategory', (data) => {
    const msg = `New category added: ${data.name || 'Unnamed category'}`;
    pushNotification(msg, { detail: 'Category created' });
});

socket.on('updateCategory', (data) => {
    const msg = `Category updated: ${data.name || 'Category'}`;
    pushNotification(msg, { detail: 'Category updated' });
});

socket.on('deleteCategory', (data) => {
    const msg = `Category deleted: ${data.name || 'Category'}`;
    pushNotification(msg, { detail: 'Category deleted' });
});

/* If you want to pre-load recent notifications from server,
   you could add an endpoint that returns last N notifications and
   fetch it here on page load. For now we start empty. */
</script>

