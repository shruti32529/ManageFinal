<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Sale - ManageEasy</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>

<div class="main-container">

  <!-- Main Content -->
  <main class="dashboard-content">

    <header class="dashboard-header" style="display:flex;align-items:center;justify-content:space-between;">
      <h1 class="page-title">Edit Sale</h1>
      <a href="/sales" class="btn-action secondary"><i class="fas fa-arrow-left"></i> Back to Sales</a>
    </header>

    <!-- Flash Messages -->
    <% if (messages && messages.success) { %>
      <div class="alert success"><%= messages.success %></div>
    <% } %>

    <% if (messages && messages.error) { %>
      <div class="alert error"><%= messages.error %></div>
    <% } %>

    <!-- Form Card -->
    <div class="card">
      <div class="card-header">Sale Details</div>
      <div class="card-body">

        <form action="/sales/edit/<%= sale._id %>" method="POST">

          <div class="form-group">
            <label>Product Name</label>
            <input type="text" name="productName" class="form-control" value="<%= sale.productName %>" required>
          </div>

          <div class="form-group">
            <label>Quantity</label>
            <input type="number" name="quantity" class="form-control" value="<%= sale.quantity %>" min="1" oninput="calculateTotal()" required>
          </div>

          <div class="form-group">
            <label>Sales Price (₹)</label>
            <input type="number" name="salesPrice" class="form-control" value="<%= sale.salesPrice %>" min="1" oninput="calculateTotal()" required>
          </div>

          <div class="form-group">
            <label>Total (₹)</label>
            <input type="number" name="total" id="total" class="form-control" value="<%= sale.total %>" readonly>
          </div>

          <div class="form-group">
            <label>Status</label>
            <select name="status" class="form-control">
              <option value="Paid" <%= sale.status === 'Paid' ? 'selected' : '' %>>Paid</option>
              <option value="Pending" <%= sale.status === 'Pending' ? 'selected' : '' %>>Pending</option>
            </select>
          </div>

          <button type="submit" class="btn-submit">
            <i class="fas fa-check-circle"></i> Update Sale
          </button>

        </form>

      </div>
    </div>

  </main>
</div>

<!-- CSS -->
<style>
body { margin:0;font-family:'Open Sans',sans-serif;background:#f8f9fa;display:flex;min-height:100vh; }
.main-container{ display:flex;width:100%; justify-content:center; padding:20px; }
.dashboard-content{ flex-grow:1; max-width:600px; width:100%; }
.page-title{ margin:0;font-weight:700;color:#212529; }

.card{ background:#fff;border:1px solid #e9ecef;border-radius:8px;box-shadow:0 4px 6px rgba(0,0,0,0.05);margin-top:20px; }
.card-header{ padding:15px;font-weight:600;background:#f8f9fa;border-bottom:1px solid #e9ecef; }
.card-body{ padding:20px; }

.form-group{ margin-bottom:16px; }
label{ font-weight:600;margin-bottom:6px;display:block; }
.form-control{ width:100%;padding:10px;border:1px solid #ced4da;border-radius:6px;font-size:1em; }

.btn-action{ background:#007bff;color:#fff;padding:8px 14px;border-radius:6px;text-decoration:none;font-weight:600; }
.btn-action.secondary{ background:#6c757d; }
.btn-submit{ width:100%;padding:12px;background:#28a745;border:none;border-radius:6px;color:#fff;font-size:1.1em;font-weight:600;cursor:pointer; }
.btn-submit:hover{ opacity:0.95; }

.alert{ padding:10px 14px;border-radius:6px;margin-top:10px;font-weight:600; }
.alert.success{ background:#d4edda;color:#155724; }
.alert.error{ background:#f8d7da;color:#721c24; }
</style>

<!-- JS -->
<script>
function calculateTotal() {
  let quantity = document.querySelector('[name="quantity"]').value;
  let price = document.querySelector('[name="salesPrice"]').value;
  document.getElementById("total").value = quantity * price;
}
</script>

</body>
</html>
