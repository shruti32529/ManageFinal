<form action="/sales/edit/<%= sale._id %>" method="POST">
    <label>Product Name:</label>
    <input type="text" name="productName" value="<%= sale.productName %>" required><br><br>

    <label>Quantity:</label>
    <input type="number" name="quantity" value="<%= sale.quantity %>" required oninput="calculateTotal()"><br><br>

    <label>Sales Price:</label>
    <input type="number" name="salesPrice" value="<%= sale.salesPrice %>" required oninput="calculateTotal()"><br><br>

    <label>Total:</label>
    <input type="number" name="total" id="total" value="<%= sale.total %>" readonly><br><br>

    <label>Status:</label>
    <select name="status">
        <option value="Paid" <%= sale.status === 'Paid' ? 'selected' : '' %>>Paid</option>
        <option value="Pending" <%= sale.status === 'Pending' ? 'selected' : '' %>>Pending</option>
    </select><br><br>

    <button type="submit">Update Sale</button>
</form>

<script>
function calculateTotal() {
    let q = document.querySelector('[name="quantity"]').value;
    let p = document.querySelector('[name="salesPrice"]').value;
    document.getElementById("total").value = q * p;
}
</script>
