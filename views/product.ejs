<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Products - ManageEasy</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="main-container">

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <span style="color: #66ccff; font-weight: bold;">ManageEasy</span>
    </div>

    <nav class="sidebar-nav">
      <ul>
        <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>

        <!-- User Management -->
        <li class="has-submenu">
          <a href="#" onclick="toggleSubmenu(event)">
            <i class="fas fa-users"></i> User Management
            <i class="fas fa-chevron-down" style="margin-left:auto;font-size:0.8em;"></i>
          </a>
          <ul class="submenu">
            <li><a href="/users"><i class="fas fa-user-circle"></i> Manage Users</a></li>
            <li><a href="/users/groups"><i class="fas fa-users-cog"></i> Manage Groups</a></li>
          </ul>
        </li>

        <!-- Categories -->
        <li><a href="/categories"><i class="fas fa-tags"></i> Categories</a></li>

        <!-- Products -->
        <li class="has-submenu open">
          <a href="#" onclick="toggleSubmenu(event)">
            <i class="fas fa-box"></i> Products
            <i class="fas fa-chevron-down" style="margin-left:auto;font-size:0.8em;"></i>
          </a>
          <ul class="submenu" style="max-height:500px;">
            <li><a href="/products" class="active"><i class="fas fa-boxes"></i> Manage Products</a></li>
            <li><a href="/products/add"><i class="fas fa-plus-circle"></i> Add Product</a></li>
          </ul>
        </li>

        <!-- Sales -->
        <li class="has-submenu">
          <a href="#" onclick="toggleSubmenu(event)">
            <i class="fas fa-chart-line"></i> Sales
            <i class="fas fa-chevron-down" style="margin-left:auto;font-size:0.8em;"></i>
          </a>
          <ul class="submenu">
            <li><a href="/sales"><i class="fas fa-list"></i> Manage Sales</a></li>
            <li><a href="/sales/add"><i class="fas fa-plus-circle"></i> Add Sale</a></li>
          </ul>
        </li>

        <li class="logout"><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
      </ul>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="dashboard-content">
    <header class="dashboard-header" style="display:flex;align-items:center;justify-content:space-between;">
      <h1 class="page-title">Manage Products</h1>
      <a href="/products/add" class="btn-action"><i class="fas fa-plus-circle"></i> Add Product</a>
    </header>

    <!-- Flash Messages -->
    <% if (messages && messages.success) { %>
      <div class="alert success"><%= messages.success %></div>
    <% } %>
    <% if (messages && messages.error) { %>
      <div class="alert error"><%= messages.error %></div>
    <% } %>

    <!-- Product List -->
    <div class="card">
      <div class="card-header">Product List</div>
      <div class="card-body">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Product Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if (products && products.length) { %>
              <% products.forEach((product, i) => { %>
                <tr data-id="<%= product._id %>">
                  <td><%= i + 1 %></td>
                  <td><%= product.name %></td>
                  <td><%= product.category ? product.category.name : "N/A" %></td>
                  <td>₹<%= product.price %></td>
                  <td><%= product.stock %></td>
                  <td style="display:flex;gap:8px;">
                    <a href="/products/edit/<%= product._id %>" class="btn-action">
                      <i class="fas fa-edit"></i> Edit
                    </a>
                    <form action="/products/delete/<%= product._id %>" method="POST" style="display:inline;">
                      <button class="btn-action secondary" onclick="return confirm('Delete this product?')">
                        <i class="fas fa-trash"></i> Delete
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center;">No products found</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<!-- CSS -->
<style>
  body { font-family:'Open Sans',sans-serif;color:#212529;background:#f8f9fa;margin:0;display:flex;min-height:100vh; }
  .main-container{ display:flex;width:100%; }
  .sidebar{ width:250px;background:#34495e;color:#fff;padding:20px;display:flex;flex-direction:column; }
  .sidebar-header{ font-size:2em;font-weight:bold;margin-bottom:20px; }
  .sidebar-nav ul{ list-style:none;padding:0;margin:0; }
  .sidebar-nav a{ color:#fff;text-decoration:none;font-size:1.1em;display:block;padding:10px;border-radius:5px; }
  .sidebar-nav a.active,.sidebar-nav a:hover{ background:#2c3e50; }
  .submenu{ list-style:none;padding-left:34px;margin:0;max-height:0;overflow:hidden;transition:max-height .3s ease; }
  .has-submenu.open .submenu{ max-height:500px; }
  .dashboard-content{ flex-grow:1;padding:20px; }
  .page-title{ margin:0;font-weight:700;color:#212529; }
  .card{ background:#fff;border:1px solid #e9ecef;border-radius:8px;box-shadow:0 4px 6px rgba(0,0,0,0.05);margin-bottom:20px; }
  .card-header{ padding:16px;border-bottom:1px solid #e9ecef;font-weight:600;color:#495057;background:#f8f9fa; }
  .card-body{ padding:20px; }
  table{ width:100%;border-collapse:collapse; }
  th,td{ padding:12px 15px;border-bottom:1px solid #e9ecef;text-align:left; }
  thead th{ background:#f2f4f6;text-transform:uppercase;font-size:0.85em;color:#343a40; }
  tr:nth-child(even){ background:#fdfdfd; }
  .btn-action{ padding:6px 12px;border-radius:6px;background:#007bff;color:#fff;text-decoration:none;font-weight:600;display:inline-flex;align-items:center;gap:6px;font-size:0.9em; }
  .btn-action.secondary{ background:#dc3545;border:none;cursor:pointer; }
  .btn-action:hover{ opacity:0.9; }
  .alert{ padding:10px 14px;border-radius:6px;margin-bottom:15px;font-weight:600; }
  .alert.success{ background:#d4edda;color:#155724; }
  .alert.error{ background:#f8d7da;color:#721c24; }
</style>

<!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  // 🔹 Add / Update product
  socket.on("update-products", (product) => {
    const tbody = document.querySelector("table tbody");
    const existingRow = document.querySelector(`tr[data-id='${product._id}']`);

    if (existingRow) {
      // Update existing row
      existingRow.innerHTML = `
        <td>#</td>
        <td>${product.name}</td>
        <td>${product.category ? product.category.name : "N/A"}</td>
        <td>₹${product.price}</td>
        <td>${product.stock}</td>
        <td style="display:flex;gap:8px;">
          <a href="/products/edit/${product._id}" class="btn-action">
            <i class="fas fa-edit"></i> Edit
          </a>
          <form action="/products/delete/${product._id}" method="POST" style="display:inline;">
            <button class="btn-action secondary" onclick="return confirm('Delete this product?')">
              <i class="fas fa-trash"></i> Delete
            </button>
          </form>
        </td>
      `;
    } else {
      // Add new row
      const row = document.createElement("tr");
      row.setAttribute("data-id", product._id);
      row.innerHTML = `
        <td>#</td>
        <td>${product.name}</td>
        <td>${product.category ? product.category.name : "N/A"}</td>
        <td>₹${product.price}</td>
        <td>${product.stock}</td>
        <td style="display:flex;gap:8px;">
          <a href="/products/edit/${product._id}" class="btn-action">
            <i class="fas fa-edit"></i> Edit
          </a>
          <form action="/products/delete/${product._id}" method="POST" style="display:inline;">
            <button class="btn-action secondary" onclick="return confirm('Delete this product?')">
              <i class="fas fa-trash"></i> Delete
            </button>
          </form>
        </td>
      `;
      tbody.appendChild(row);
    }
    updateRowNumbers();
  });

  // 🔹 Delete product
  socket.on("delete-product", (id) => {
    const row = document.querySelector(`tr[data-id='${id}']`);
    if (row) row.remove();
    updateRowNumbers();
  });

  function updateRowNumbers() {
    document.querySelectorAll("table tbody tr").forEach((tr, index) => {
      tr.querySelector("td:first-child").textContent = index + 1;
    });
  }

  function toggleSubmenu(e){
    e.preventDefault();
    const parent = e.currentTarget.parentElement;
    parent.classList.toggle("open");
  }
</script>

</body>
</html>
