<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sales Report By Date - ManageEasy</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    /* Same layout style like “Add Category” page */
    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 900px;
      margin: 30px auto;
      padding: 20px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
      color: #333;
    }
    .btn {
      display: inline-block;
      padding: 10px 18px;
      font-size: 14px;
      text-decoration: none;
      border-radius: 4px;
      transition: 0.3s;
    }
    .btn.secondary {
      background-color: #e0e0e0;
      color: #333;
    }
    .btn.secondary:hover { background-color: #d5d5d5; }

    .card {
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      padding: 25px;
    }
    .card-header {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 20px;
    }
    .form-group { margin-bottom: 20px; }
    label { display: block; margin-bottom: 6px; font-weight: 500; }
    .form-control {
      width: 100%;
      padding: 10px 12px;
      border-radius: 4px;
      border: 1px solid #ccc;
      font-size: 15px;
    }
    .btn.primary {
      background-color: #28a745;
      color: white;
      border: none;
      cursor: pointer;
    }
    .btn.primary:hover { background-color: #218838; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }
    th {
      background-color: #007bff;
      color: white;
      font-weight: 600;
    }
    th, td {
      padding: 10px;
      text-align: center;
      border: 1px solid #ddd;
    }
    tr:nth-child(even) { background-color: #f2f2f2; }
    .total {
      text-align: right;
      font-weight: bold;
      font-size: 18px;
      margin-top: 15px;
    }
    .alert {
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 15px;
      font-weight: 600;
      background-color: #f8d7da;
      color: #721c24;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      <h1>📊 Sales Report By Date</h1>
      <a href="/dashboard" class="btn secondary"><i class="fa fa-arrow-left"></i> Back to Dashboard</a>
    </div>

    <div class="card">
      <div class="card-header">Filter Report</div>
      <form action="/report/sales-report" method="POST" class="form">
        <div class="form-group">
          <label for="startDate">Start Date</label>
          <input type="date" id="startDate" name="startDate" class="form-control" required value="<%= startDate %>" />
        </div>

        <div class="form-group">
          <label for="endDate">End Date</label>
          <input type="date" id="endDate" name="endDate" class="form-control" required value="<%= endDate %>" />
        </div>

        <button type="submit" class="btn primary"><i class="fa fa-filter"></i> Generate Report</button>
      </form>

      <% if (error) { %>
        <div class="alert"><%= error %></div>
      <% } %>

      <% if (sales && sales.length > 0) { %>
        <h3>Total <%= sales.length %> records found</h3>
        <table>
          <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Total (₹)</th>
            <th>Date</th>
          </tr>
          <% sales.forEach(sale => { %>
            <tr>
              <td><%= sale.productName %></td>
              <td><%= sale.quantity %></td>
              <td>₹<%= sale.total %></td>
              <td><%= sale.createdAt.toLocaleDateString() %></td>
            </tr>
          <% }) %>
        </table>

        <p class="total">💰 Total Income: ₹<%= totalIncome %></p>
      <% } %>

    </div>
  </div>
</body>
</html>
