<!DOCTYPE html>
<html>
<head>
    <title>Monthly Sales Report</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h2>📊 Monthly Sales Report</h2>

    <!-- 🔹 Corrected Path -->
    <form action="/report/month" method="GET">
        <label>Select Month:</label>
        <input type="month" name="month" required>
        <button type="submit">Generate Report</button>
    </form>

    <% if (sales && sales.length > 0) { %>
        <table border="1" cellpadding="8">
            <thead>
                <tr>
                    <th>Invoice No</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Total Amount</th>
                </tr>
            </thead>
            <tbody>
                <% let total = 0; %>
                <% sales.forEach(sale => { %>
                    <tr>
                        <td><%= sale.invoice_no %></td>
                        <td><%= sale.createdAt.toLocaleDateString() %></td> <!-- 🔹 Use createdAt instead of date -->
                        <td><%= sale.customer %></td>
                        <td><%= sale.total %></td> <!-- 🔹 Field name is "total" from your model -->
                    </tr>
                    <% total += sale.total; %>
                <% }) %>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3"><b>Total Sales</b></td>
                    <td><b><%= total %></b></td>
                </tr>
            </tfoot>
        </table>

        <!-- 🔹 Correct PDF Export Link -->
        <a href="/report/month/pdf?month=<%= selectedMonth %>">
            <button>Export as PDF</button>
        </a>

    <% } else if (typeof sales !== 'undefined') { %>
        <p>No records found for selected month.</p>
    <% } %>
</body>
</html>
