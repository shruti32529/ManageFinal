<!DOCTYPE html>
<html lang="en">
<%
  const detailLabels = {
    name: 'Name',
    description: 'Description',
    category: 'Category',
    parent: 'Parent category',
    stock: 'Stock',
    price: 'Price',
    productName: 'Product',
    quantity: 'Quantity',
    salesPrice: 'Unit price',
    total: 'Total',
    status: 'Status',
    role: 'Role',
    email: 'Email',
    avatar: 'Profile photo'
  };
  const formatActivityValue = (key, value) => {
    if (value === null || value === undefined || value === '') return '—';
    if (['price', 'salesPrice', 'total'].includes(key) && Number.isFinite(Number(value))) {
      return '$' + Number(value).toFixed(2);
    }
    return String(value);
  };
  const getActivityDetails = (details) => {
    const data = details && typeof details === 'object' ? details : {};
    const before = data.before && typeof data.before === 'object' ? data.before : null;
    const after = data.after && typeof data.after === 'object' ? data.after : null;
    if (before || after) {
      const keys = new Set([...Object.keys(before || {}), ...Object.keys(after || {})]);
      return [...keys]
        .filter((key) => !before || !after || String(before[key] ?? '') !== String(after[key] ?? ''))
        .map((key) => ({
          label: detailLabels[key] || key,
          value: before && after
            ? `${formatActivityValue(key, before[key])} → ${formatActivityValue(key, after[key])}`
            : formatActivityValue(key, (after || before)[key])
        }));
    }
    return Object.entries(data).map(([key, value]) => ({
      label: detailLabels[key] || key,
      value: formatActivityValue(key, value)
    }));
  };
%>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Activity - ManageEasy</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="activity-shell">
    <aside class="sidebar">
      <div class="sidebar-header">ManageEasy</div>
      <nav class="sidebar-nav">
        <ul>
          <li><a href="/admin"><i class="fa fa-tachometer-alt"></i> Admin Dashboard</a></li>
          <li><a href="/users"><i class="fa fa-users"></i> User Management</a></li>
          <li><a class="active" href="/admin/activity"><i class="fa fa-clipboard-list"></i> Staff Activity</a></li>
          <li><a href="/categories"><i class="fa fa-tags"></i> Categories</a></li>
          <li><a href="/products"><i class="fa fa-box"></i> Products</a></li>
          <li><a href="/sales"><i class="fa fa-chart-line"></i> Sales</a></li>
          <li><a href="/report/sales-report"><i class="fa fa-file-invoice"></i> Sales Report</a></li>
          <li class="logout"><a href="/logout"><i class="fa fa-sign-out-alt"></i> Logout</a></li>
        </ul>
      </nav>
      <% if (currentUser) { %>
        <div class="sidebar-footer">
          <span class="user-name"><%= currentUser.name || currentUser.email %></span>
        </div>
      <% } %>
    </aside>

    <main class="activity-page">
      <header class="activity-heading">
        <div>
          <h1>Staff Activity</h1>
          <p>Only staff sign-ins, sales, and changes made to products, categories, and profiles are shown here.</p>
        </div>
        <a class="back-link" href="/admin"><i class="fa fa-arrow-left"></i> Back to dashboard</a>
      </header>

      <section class="activity-card">
        <div class="activity-summary">
          <strong><%= totalCount %></strong> staff activities
          <% if (totalCount === 0) { %>
            <p>Activity tracking starts after this update is deployed. Sign in with a staff account and add, edit, or sell something to create the first record. Older records cannot be attributed retroactively.</p>
          <% } %>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Date and time</th>
                <th>Staff member</th>
                <th>Action</th>
                <th>Record</th>
                <th>Change details</th>
              </tr>
            </thead>
            <tbody>
              <% if (activities.length) { %>
                <% activities.forEach((activity) => { %>
                  <tr>
                    <td><%= new Date(activity.createdAt).toLocaleString() %></td>
                    <td><strong><%= activity.actorName %></strong><br><small><%= activity.actorEmail %></small></td>
                    <td><span class="action-badge"><%= activity.action.replace('_', ' ') %></span></td>
                    <td><strong><%= activity.entityType %></strong><%= activity.entityName ? ': ' + activity.entityName : '' %></td>
                    <td>
                      <% const detailRows = getActivityDetails(activity.details); %>
                      <% if (detailRows.length) { %>
                        <ul class="details-list">
                          <% detailRows.forEach((detail) => { %>
                            <li><span><%= detail.label %></span><strong><%= detail.value %></strong></li>
                          <% }) %>
                        </ul>
                      <% } else if (activity.action === 'signed_in') { %>
                        <span class="muted-detail">Staff signed in</span>
                      <% } else if (activity.action === 'signed_out') { %>
                        <span class="muted-detail">Staff signed out</span>
                      <% } else { %>
                        <span class="muted-detail">No additional details</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="5" class="empty-state">No staff activity recorded yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <% if (pageCount > 1) { %>
        <nav class="pagination" aria-label="Activity pages">
          <% if (page > 1) { %>
            <a href="/admin/activity?page=<%= page - 1 %>">Previous</a>
          <% } %>
          <span>Page <%= page %> of <%= pageCount %></span>
          <% if (page < pageCount) { %>
            <a href="/admin/activity?page=<%= page + 1 %>">Next</a>
          <% } %>
        </nav>
      <% } %>
    </main>
  </div>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      color: #212529;
      background: #f5f7fa;
      font-family: "Open Sans", Arial, sans-serif;
    }

    .activity-shell {
      display: flex;
      min-height: 100vh;
    }

    .activity-shell .sidebar {
      width: 250px;
      min-width: 250px;
      padding: 20px;
      background: #34495e;
      color: #fff;
    }

    .sidebar-header {
      margin-bottom: 24px;
      color: #66ccff;
      font-size: 1.8rem;
      font-weight: 700;
    }

    .sidebar-nav ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .sidebar-nav li {
      margin: 8px 0;
    }

    .sidebar-nav a {
      display: block;
      padding: 10px;
      border-radius: 5px;
      color: #fff;
      text-decoration: none;
    }

    .sidebar-nav a:hover,
    .sidebar-nav a.active {
      background: #2c3e50;
    }

    .sidebar-nav i {
      width: 22px;
    }

    .sidebar-footer {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .activity-page {
      flex: 1;
      min-width: 0;
      padding: 32px;
    }

    .activity-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 24px;
    }

    .activity-heading h1 {
      margin: 0 0 8px;
    }

    .activity-heading p {
      margin: 0;
      color: #6c757d;
    }

    .back-link {
      flex: 0 0 auto;
      color: #1769aa;
      text-decoration: none;
    }

    .activity-card {
      overflow: hidden;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
    }

    .activity-summary {
      padding: 18px 20px;
      border-bottom: 1px solid #e5e7eb;
    }

    .activity-summary p {
      margin: 8px 0 0;
      color: #6c757d;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 13px 16px;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
      vertical-align: top;
    }

    th {
      background: #f2f4f6;
      white-space: nowrap;
    }

    td small {
      color: #6c757d;
    }

    .details-list {
      min-width: 180px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .details-list li {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 3px 0;
    }

    .details-list li + li {
      border-top: 1px solid #f0f2f5;
    }

    .details-list li span,
    .muted-detail {
      color: #6c757d;
    }

    .details-list li strong {
      max-width: 280px;
      overflow-wrap: anywhere;
      text-align: right;
      font-weight: 600;
      font-size: 0.85em;
    }

    .details-list li span {
      flex: 0 0 auto;
    }

    .muted-detail {
      white-space: nowrap;
    }

    .action-badge {
      display: inline-block;
      padding: 4px 9px;
      border-radius: 12px;
      background: #e8f1ff;
      color: #174ea6;
      text-transform: capitalize;
      white-space: nowrap;
    }

    .empty-state {
      padding: 32px;
      color: #6c757d;
      text-align: center;
    }

    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      margin-top: 20px;
    }

    @media (max-width: 760px) {
      .activity-shell {
        display: block;
      }

      .activity-shell .sidebar {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
      }

      .activity-page {
        padding: 20px 12px;
      }

      .activity-heading {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</body>
</html>
