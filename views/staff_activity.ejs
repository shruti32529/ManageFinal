<% layout('layout') -%>

<section class="activity-page">
  <div class="activity-heading">
    <div>
      <h1>Staff Activity</h1>
      <p>Recorded staff sign-ins, sales, and changes made to products, categories, and profiles. Tracking starts after this update is deployed.</p>
    </div>
    <a class="btn primary" href="/admin">Back to dashboard</a>
  </div>

  <div class="activity-card">
    <div class="activity-summary"><%= totalCount %> recorded staff activities</div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date and time</th>
            <th>Staff member</th>
            <th>Action</th>
            <th>Record</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          <% if (activities.length) { %>
            <% activities.forEach((activity) => { %>
              <tr>
                <td><%= new Date(activity.createdAt).toLocaleString() %></td>
                <td><strong><%= activity.actorName %></strong><br><small><%= activity.actorEmail %></small></td>
                <td><span class="action-badge"><%= activity.action.replace('_', ' ') %></span></td>
                <td><strong><%= activity.entityType %></strong><%= activity.entityName ? ': ' + activity.entityName : '' %></td>
                <td><pre><%= JSON.stringify(activity.details || {}, null, 2) %></pre></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="empty-state">No staff activity has been recorded yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (pageCount > 1) { %>
    <nav class="pagination" aria-label="Activity pages">
      <% if (page > 1) { %>
        <a href="/admin/activity?page=<%= page - 1 %>">Previous</a>
      <% } %>
      <span>Page <%= page %> of <%= pageCount %></span>
      <% if (page < pageCount) { %>
        <a href="/admin/activity?page=<%= page + 1 %>">Next</a>
      <% } %>
    </nav>
  <% } %>
</section>

<style>
  .activity-page {
    width: 100%;
    padding: 24px;
    color: #212529;
  }

  .activity-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .activity-heading h1 {
    margin: 0 0 6px;
  }

  .activity-heading p {
    margin: 0;
    color: #6c757d;
  }

  .activity-card {
    overflow: hidden;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
  }

  .activity-summary {
    padding: 16px 20px;
    border-bottom: 1px solid #e5e7eb;
    font-weight: 600;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th, td {
    padding: 12px 16px;
    border-bottom: 1px solid #e5e7eb;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: #f8f9fa;
    white-space: nowrap;
  }

  td small {
    color: #6c757d;
  }

  td pre {
    min-width: 220px;
    max-width: 480px;
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: inherit;
    font-size: 0.85em;
  }

  .action-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 12px;
    background: #e8f1ff;
    color: #174ea6;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .empty-state {
    padding: 32px;
    color: #6c757d;
    text-align: center;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }

  .pagination a {
    color: #1769aa;
  }

  @media (max-width: 640px) {
    .activity-page {
      padding: 16px 8px;
    }

    .activity-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
